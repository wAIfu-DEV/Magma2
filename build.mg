mod main

# Used for bootstrap building using the compiler implemented in golang
# @author devan
# @author codex (GPT6 Luna)

use "std:process" proc
use "std:fs"      fs
use "std:path"    path
use "std:hash"    hash
use "std:strconv" strconv
use "std:strings" strings
use "std:heap" heap
use "std:list" ls

VersionState(
    value u64
    count u64
)

global sourceState VersionState
global targetTriple str

freeString(value $str) void:
    value.free()
..

appendFlags(arguments ls.List[str]*, flags str) !void:
    lines := try strings.split(flags, "\n")
    defer lines.free()
    for lineIndex := 0 to lines.count():
        line := try lines.get(lineIndex)
        normalized := try strings.trim(line)
        defer normalized.free()
        parts := try strings.split(normalized, " ")
        defer parts.free()
        for i := 0 to parts.count():
            part := try parts.get(i)
            if part.countBytes() > 0:
                try arguments.pushRight(try strings.copy(part))
            ..
        ..
    ..
..

writeTargetInfo() !void:
    cxxFlags := try proc.capture("llvm-config", []str("--cxxflags"))
    defer cxxFlags.free()
    linkFlags := try proc.capture("llvm-config", []str("--ldflags", "--libs", "all", "--system-libs"))
    defer linkFlags.free()

    arguments := try ls.new[str](heap.allocator(), freeString)
    defer arguments.free()
    # TODO: i think this sucks
    try arguments.pushRight(try strings.copy("src/llvm_target_info.cpp"))
    try appendFlags(addrof arguments, cxxFlags)
    try appendFlags(addrof arguments, linkFlags)
    try arguments.pushRight(try strings.copy("-o"))
    try arguments.pushRight(try strings.copy("magma-target-info"))
    buildCode := try proc.exec("clang++", arguments.view())
    if buildCode != 0:
        throw "failed to build the LLVM target information helper"
    ..

    targetInfo := try proc.capture("./magma-target-info", []str())
    defer targetInfo.free()
    normalizedTriple := try strings.trim(targetInfo)
    defer normalizedTriple.free()
    if normalizedTriple.countBytes() == 0:
        throw "LLVM target information helper returned an empty target triple"
    ..
    targetTriple = try strings.copy(normalizedTriple)
    fs.removeFile("magma-target-info")
..

addSource(state VersionState*, filePath str) !void:
    extension := try path.extension(filePath)
    defer extension.free()
    isMagmaSource := strings.compare(extension, ".mg")
    isCppSource := strings.compare(extension, ".cpp")
    if isMagmaSource == false && isCppSource == false:
        ret
    ..
    base := try path.base(filePath)
    defer base.free()
    if strings.compare(base, "compiler_version.mg"):
        ret
    ..
    contents := try fs.readFile(filePath)
    defer contents.free()
    pathHash := hash.string(filePath)
    contentsHash := hash.string(contents)
    # A commutative accumulator makes the result independent of filesystem
    # directory iteration order while still binding each source to its path.
    state.value = state.value + pathHash * 1099511628211 + contentsHash
    state.count = state.count + 1
..

visitSource(filePath str, isDirectory bool) !void:
    if isDirectory:
        ret
    ..
    try addSource(addrof sourceState, filePath)
..

sourceFingerprint() !$str:
    sourceState = VersionState(value=14695981039346656037, count=0)
    try addSource(addrof sourceState, "main.mg")
    try addSource(addrof sourceState, "build.mg")
    try fs.walk("src", visitSource)
    sourceState.value = sourceState.value + hash.string(targetTriple) * 1099511628211
    sourceState.count = sourceState.count + 1
    value := try strconv.formatUint(sourceState.value)
    defer value.free()
    count := try strconv.formatUint(sourceState.count)
    defer count.free()
    prefix := try strings.concat("magma2-", value)
    defer prefix.free()
    separated := try strings.concat(prefix, "-")
    defer separated.free()
    ret try strings.concat(separated, count)
..

writeCompilerVersion() !void:
    version := try sourceFingerprint()
    defer version.free()
    prefix := try strings.concat("mod compiler_version\n# GENERATED BY build.mg\npub const VERSION str = \"", version)
    defer prefix.free()
    withVersion := try strings.concat(prefix, "\"\npub const TARGET_TRIPLE str = \"")
    defer withVersion.free()
    withTriple := try strings.concat(withVersion, targetTriple)
    defer withTriple.free()
    body := try strings.concat(withTriple, "\"\n")
    defer body.free()
    try fs.writeFile("src/compiler_version.mg.tmp", body)
    try fs.replace("src/compiler_version.mg.tmp", "src/compiler_version.mg")
..

main() !u32:
    try writeTargetInfo()
    try writeCompilerVersion()
    fs.removeFile("./magma")

    process := try proc.spawn("magma", []str(
        "--preset", "fast-runtime",
        "--std", "std",
        "--out", "magma",
        "main.mg",
    ))

    code := try process.await()
    ret code
..
